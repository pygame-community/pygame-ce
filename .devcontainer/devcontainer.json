{
  "name": "pygame-ce devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--net=host",

    "--gpus=all",
    "--device", "/dev/dri:/dev/dri",

    "-e", "DISPLAY",
    //"-e", "SDL_AUDIODRIVER=dummy",

    // Skip hardware OpenGL and do Software-only OpenGL
    //"-e", "LIBGL_ALWAYS_SOFTWARE=1",

    "-e", "NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility,video",

    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "-e",
    "WAYLAND_DISPLAY=${env:WAYLAND_DISPLAY}",
    "-e",
    "XDG_RUNTIME_DIR",
    "-v",
    "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}:/run/user/1000/${env:WAYLAND_DISPLAY}",

    "-e",
    "XAUTHORITY=/home/vscode/.Xauthority",
    "-v",
    "${localEnv:XAUTHORITY}:/home/vscode/.Xauthority:ro"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "VIRTUAL_ENV": "/workspaces/pygame-ce/.venv"
  },
  "remoteEnv": {
    "PATH": "/workspaces/pygame-ce/.venv/bin:${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install 'meson-python<=0.20.0' 'meson<=1.11.2' 'ninja<=1.13.0' 'cython<=3.2.9' 'sphinx<=8.2.3' 'astroid<4.0.0' 'sphinx-autoapi<=3.6.0' 'pyproject-metadata!=0.9.1' && .venv/bin/python -m pip install --no-build-isolation --editable . 'pytest>=8,<9' 'ruff>=0.6,<1'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/pygame-ce/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "ruff.nativeServer": "on"
      }
    }
  }
}